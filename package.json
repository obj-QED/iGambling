{
  "name": "igambling",
  "private": true,
  "version": "0.0.0",
  "packageManager": "yarn@4.13.0",
  "engines": {
    "node": ">=22"
  },
  "browserslist": [
    "Chrome >= 90",
    "Firefox >= 90",
    "Safari >= 13",
    "iOS >= 13",
    "Edge >= 90"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:analyze": "VITE_ANALYZE=true yarn build",
    "scaffold": "node scripts/create-module.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix && stylelint \"src/**/*.{css,scss}\" --fix",
    "check:precommit": "yarn lint && yarn stylelint && yarn build",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "format": "prettier . --write",
    "stylelint": "stylelint \"src/**/*.{css,scss}\"",
    "audit:deps": "node scripts/audit-deps.mjs",
    "prepare": "husky",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test:a11y": "node .github/scripts/storybook-a11y.mjs",
    "storybook:ai-review": "node .github/scripts/storybook-ai-review.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "chromatic --exit-zero-on-changes"
  },
  "lint-staged": {
    "*.{ts,tsx,js,json,md}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,scss}": [
      "stylelint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@mantine/core": "^9.2.2",
    "@mantine/hooks": "^9.2.2",
    "@reduxjs/toolkit": "^2.3.0",
    "@tabler/icons-react": "^3.44.0",
    "@tanstack/react-query": "^5.59.0",
    "@tanstack/react-query-devtools": "^5.59.0",
    "axios": "^1.13.5",
    "clsx": "^2.1.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-inlinesvg": "^4.4.1",
    "react-redux": "^9.1.2",
    "react-router-dom": "^6.28.0",
    "ua-parser-js": "1.0.41",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@chromatic-com/storybook": "^5.2.1",
    "@eslint/js": "^9.15.0",
    "@storybook/addon-a11y": "^10.4.6",
    "@storybook/addon-docs": "^10.4.6",
    "@storybook/addon-mcp": "^0.6.0",
    "@storybook/addon-vitest": "^10.4.6",
    "@storybook/react-vite": "^10.4.6",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.9.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ua-parser-js": "0.7.39",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/browser-playwright": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.8",
    "autoprefixer": "^10.5.4",
    "chromatic": "^11.27.0",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.14",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-storybook": "^10.4.6",
    "globals": "^15.12.0",
    "husky": "^9.1.7",
    "jsdom": "^29.0.1",
    "lightningcss": "^1.32.0",
    "lint-staged": "^16.4.0",
    "playwright": "^1.61.1",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "sass": "^1.77.0",
    "storybook": "^10.4.6",
    "stylelint": "^17.6.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.15.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.8"
  }
}
